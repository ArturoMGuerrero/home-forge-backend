# Configuración Backend - HomeForge

# Base de datos PostgreSQL
DB_NAME=homeforge
DB_USERNAME=postgres
DB_PASSWORD=${DB_PASSWORD}
DB_URL=jdbc:postgresql://localhost:5432/homeforge

# Puerto del servidor
SERVER_PORT=8080

# Orígenes permitidos para CORS (separados por coma)
# IMPORTANTE: Agregar la IP de red para acceso desde otras computadoras
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://172.27.9.148:5174

# Directorio para archivos subidos
UPLOADS_DIRECTORY=uploads

# ============================================
# Configuración de Mercado Pago (PRUEBA)
# ============================================
MERCADOPAGO_ACCESS_TOKEN=${MERCADOPAGO_ACCESS_TOKEN}
MERCADOPAGO_PUBLIC_KEY=${MERCADOPAGO_PUBLIC_KEY}

# Precios de planes México (en pesos MXN - NO centavos)
# STARTER MX: $299 MXN
# PRO MX: $999 MXN
# BUSINESS MX: $3,999 MXN
PLAN_STARTER_PRICE=299
PLAN_PRO_PRICE=999
PLAN_BUSINESS_PRICE=3999

# URL del frontend (para redirecciones)
FRONTEND_URL=http://localhost:5174

# ============================================
# Configuración de Base de Datos SQL Server
# ============================================
# Para usar SQL Server, inicia con: mvn spring-boot:run -Dspring-boot.run.profiles=sqlserver
# La cadena de conexión usa autenticación integrada de Windows
# DB_URL no es necesario porque está en application-sqlserver.yml
# Si quieres usar autenticación SQL Server, descomenta y configura:
# DB_USERNAME=tu_usuario
# DB_PASSWORD=tu_password
